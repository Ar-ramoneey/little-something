# Copy this file to .env for local work and fill in real values locally.
# Never commit .env or any other secret environment file.
# In Vercel, add these same names in Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Required server-only variables (no VITE_ prefix)
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co

# Current Supabase API key format. The secret key belongs only on the server.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Temporary bootstrap invitation code. After migration 6, generate a code from
# the admin dashboard; the database-backed code then becomes authoritative and
# this value is ignored. Keep it only until that first code is generated.
INVITATION_CODE=replace-with-the-private-invitation-code
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Admin notification recipient. Use the real address; do not invent one.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Resend. RESEND_FROM_EMAIL must be a verified sender in Resend.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=verified-sender@example.com

# Exact production origin. Used for CSRF checks and the admin email link.
APP_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# Browser-safe values (safe to expose; never mirror secret keys here)
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Non-secret identifier. Keep in sync with the server if overridden.
# PROPOSAL_ID=roqeebah-001
# VITE_PROPOSAL_ID=roqeebah-001

# ---------------------------------------------------------------------------
# Optional settings
# ---------------------------------------------------------------------------

# INVITATION_SESSION_TTL_SECONDS=604800
# RESEND_TIMEOUT_MS=5000

# Legacy fallback for existing local setups only. Prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# Overrides. Normally derived from APP_URL; do not set unless necessary.
# ADMIN_DASHBOARD_URL=https://your-project.vercel.app/admin/responses
# ALLOWED_ORIGINS=https://your-project.vercel.app
